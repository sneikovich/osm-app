# Rendered by the nginx image's envsubst entrypoint into /etc/nginx/conf.d/default.conf.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Re-resolve the fetcher on every request so `--scale fetcher=N` spreads load.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    location / {
        try_files $uri $uri/ =404;
    }

    location /api/ {
        set $fetcher ${FETCHER_URL};
        proxy_pass $fetcher;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Overpass timeout (<=180s) + client slack + retry back-off.
        proxy_read_timeout 300s;
        client_max_body_size 16k;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
